# gh anchor init scans the Dockerfile and generates .gh-anchor.toml.

# --offline --stdout: decide from the Dockerfile alone and print the config.
exec gh-anchor init --offline --stdout
stderr 'Scanned Dockerfile: 3 ARG\(s\) with a datasource, 2 image\(s\), 1 package\(s\), 1 ARG\(s\) without a detected datasource'
! stderr 'Checking'
cmp stdout expected-offline.toml
! exists .gh-anchor.toml

# Without a terminal (and without --yes), the config is printed, not written.
exec gh-anchor init
stderr 'No terminal to prompt in: printing the config. Use --yes to write \.gh-anchor\.toml\.'
stdout '^\[args.NODE_VERSION\]$'
! exists .gh-anchor.toml

# --yes looks everything up and writes the file.
exec gh-anchor init --yes
stderr 'Checking 6 item\(s\) against npm, Node.js, GitHub and the image registries'
stderr 'Config file \.gh-anchor\.toml created'
grep '^# Verified: Node.js 22.23.4 is an LTS release$' .gh-anchor.toml
grep '^# Verified: 12.2.1 is a version of npm package npm$' .gh-anchor.toml
grep '^# Verified: 444444444444 is the head of master and not tagged, so track = "branch"$' .gh-anchor.toml
grep '^  track      = "branch"$' .gh-anchor.toml
grep '^# Verified: pnpm@12.16.1 is published; hash from npm$' .gh-anchor.toml
grep '^  hash    = "sha512\.[0-9a-f]{128}"$' .gh-anchor.toml
! grep 'not found|not verified' .gh-anchor.toml

# The generated config works (on a copy, so later steps see the original).
cp Dockerfile Dockerfile.copy
exec gh-anchor -u Dockerfile.copy
stderr 'Summary for Dockerfile.copy: 8 checked, 5 updated, 1 up to date, 2 skipped \(not in \.gh-anchor\.toml: 2\), 0 failed'

# Running --yes again backs up the existing file first.
exec gh-anchor init --yes
stderr 'Backup file \.gh-anchor\.toml-[0-9]{12} created'
stderr 'Config file \.gh-anchor\.toml created'

# Two Dockerfiles whose base stages use different images would share [images.base]:
# init reports it and writes nothing.
cp .gh-anchor.toml config.before
! exec gh-anchor init --yes --offline Dockerfile other/Dockerfile
stderr '❌  \[images.base\] would record .*/library/ubuntu:24.04 \(Dockerfile:1\) and .*/library/ubuntu:26.04 \(other/Dockerfile:1\)'
stderr 'no config written'
cmp .gh-anchor.toml config.before

# --yes and --stdout can't be combined; paths outside the project are rejected.
! exec gh-anchor init --yes --stdout
stderr 'none of the others can be'
! exec gh-anchor init ../Dockerfile
stderr 'contains'

-- Dockerfile --
FROM {{registry}}/library/ubuntu:24.04 AS base
ARG NODE_VERSION=22.23.4
ARG NPM_VERSION=12.2.1
ARG ZSH_AUTOSUGGESTIONS_SHA=4444444444444444444444444444444444444444
ARG USERNAME=dev
ARG MYSTERY_VERSION=1.2.3
RUN git init /z && git -C /z remote add origin https://github.com/zsh-users/zsh-autosuggestions.git \
    && git -C /z fetch --depth 1 origin "${ZSH_AUTOSUGGESTIONS_SHA}"
COPY --from=base /etc/os-release /tmp/
COPY --from={{registry}}/zizmorcore/zizmor:1.31.1 /usr/bin/zizmor /usr/local/bin/zizmor
RUN corepack prepare pnpm@12.16.1 --activate
-- other/Dockerfile --
FROM {{registry}}/library/ubuntu:26.04 AS base
-- expected-offline.toml --
# gh-anchor configuration, generated by `gh anchor init` from Dockerfile.
# gh-anchor only updates what is listed here. Image and package tables record the
# tag, digest, version and hash in the Dockerfile; gh-anchor keeps them current.
# Every setting is described at https://github.com/esacteksab/gh-anchor#configuration

# FROM {{registry}}/library/ubuntu:24.04 AS base (Dockerfile:1)
# Default: lts = true, so bumping only moves between Ubuntu LTS releases (24.04 -> 26.04)
[images.base]
  image     = "{{registry}}/library/ubuntu"
  tag       = "24.04"
  digest    = ""
  fixed-tag = false
  lts       = true
  target    = ""
  bump      = false
  skip      = false

# COPY --from={{registry}}/zizmorcore/zizmor:1.31.1 (Dockerfile:10)
[images."{{registry}}/zizmorcore/zizmor"]
  image     = "{{registry}}/zizmorcore/zizmor"
  tag       = "1.31.1"
  digest    = ""
  fixed-tag = false
  lts       = false
  target    = ""
  bump      = false
  skip      = false

# RUN corepack … pnpm@12.16.1 (Dockerfile:11)
# Passed to corepack, so gh-anchor pins it as pnpm@<version>+sha512.<hex>
[packages.pnpm]
  version = "12.16.1"
  hash    = ""
  target  = ""
  bump    = false
  skip    = false

# ARG NODE_VERSION=22.23.4 (Dockerfile:2)
# Detected: known ARG name NODE_VERSION
[args.NODE_VERSION]
  datasource = "node-version"
  lts        = true
  target     = ""
  bump       = false
  skip       = false

# ARG NPM_VERSION=12.2.1 (Dockerfile:3)
# Detected: known ARG name NPM_VERSION
[args.NPM_VERSION]
  datasource = "npm"
  package    = "npm"
  target     = ""
  bump       = false
  skip       = false

# ARG ZSH_AUTOSUGGESTIONS_SHA=4444444444444444444444444444444444444444 (Dockerfile:4)
# Detected: used with https://github.com/zsh-users/zsh-autosuggestions
[args.ZSH_AUTOSUGGESTIONS_SHA]
  datasource = "github-commits"
  repo       = "zsh-users/zsh-autosuggestions"
  track      = "branch"
  bump       = false
  skip       = false

# ARGs named like versions (*VERSION*, *_SHA, *_COMMIT) whose source couldn't be
# detected. Add an [args.NAME] table with a datasource for any gh-anchor should update:
#   ARG MYSTERY_VERSION=1.2.3 (Dockerfile:6)
